file write tex "\label{tab:lpm_outside_all}" _n
file write tex "\small" _n


* -------------------------------------------------------------------------- *
* Paneles A, B y C: modelos sin y con controles
* -------------------------------------------------------------------------- *

file write tex "\begin{tabular}{lcc}" _n
file write tex "\hline" _n
file write tex "Specification & No controls & Controls \\" _n
file write tex "\hline" _n


* -------------------------------------------------------------------------- *
* Panel A: Post x exposicion historica
* -------------------------------------------------------------------------- *

file write tex ///
    "\multicolumn{3}{l}{\textit{Panel A: Post-period Spanish historical exposure}} \\" _n

use "$output_models/lpm_outside_01_post_share_stata.dta", clear

gen str12 no_fmt = ///
    string(no_controls_pct, "%5.2f") + "\%"

gen str12 yes_fmt = ///
    string(with_controls_pct, "%5.2f") + "\%"

local p0 = no_fmt[1]
local p1 = yes_fmt[1]

file write tex ///
    "Post-period Spanish historical exposure & `p0' & `p1' \\" _n

file write tex "\addlinespace" _n


* -------------------------------------------------------------------------- *
* Panel B: Post x caracteristicas municipales
* -------------------------------------------------------------------------- *

file write tex ///
    "\multicolumn{3}{l}{\textit{Panel B: Post-period municipal characteristics}} \\" _n

use "$output_models/lpm_outside_01_post_x_stata.dta", clear

gen str12 no_fmt = ///
    string(no_controls_pct, "%5.2f") + "\%"

gen str12 yes_fmt = ///
    string(with_controls_pct, "%5.2f") + "\%"

sort row_order

forvalues i = 1/`=_N' {

    local lab = term_label[`i']
    local p0  = no_fmt[`i']
    local p1  = yes_fmt[`i']

    file write tex ///
        "`lab' & `p0' & `p1' \\" _n
}

file write tex "\addlinespace" _n


* -------------------------------------------------------------------------- *
* Panel C: triples diferencias
* -------------------------------------------------------------------------- *

file write tex ///
    "\multicolumn{3}{l}{\textit{Panel C: Triple-difference specifications}} \\" _n

use "$output_models/lpm_outside_01_triple_stata.dta", clear

gen str12 no_fmt = ///
    string(no_controls_pct, "%5.2f") + "\%"

gen str12 yes_fmt = ///
    string(with_controls_pct, "%5.2f") + "\%"

sort row_order

forvalues i = 1/`=_N' {

    local lab = variable_label[`i']
    local p0  = no_fmt[`i']
    local p1  = yes_fmt[`i']

    file write tex ///
        "`lab' & `p0' & `p1' \\" _n
}

file write tex "\hline" _n
file write tex "\end{tabular}" _n

file write tex "\vspace{0.7em}" _n


* -------------------------------------------------------------------------- *
* Panel D: heterogeneidad por terciles
* -------------------------------------------------------------------------- *

file write tex "\begin{tabular}{lccc}" _n
file write tex "\hline" _n

file write tex ///
    "Municipal characteristic defining terciles & T1 & T2 & T3 \\" _n

file write tex "\hline" _n

file write tex ///
    "\multicolumn{4}{l}{\textit{Panel D: Heterogeneity by municipal tercile}} \\" _n

use "$output_models/lpm_outside_01_heterogeneity_stata.dta", clear

gen str12 t1_fmt = ///
    string(tercile1_pct, "%5.2f") + "\%"

gen str12 t2_fmt = ///
    string(tercile2_pct, "%5.2f") + "\%"

gen str12 t3_fmt = ///
    string(tercile3_pct, "%5.2f") + "\%"

sort row_order

forvalues i = 1/`=_N' {

    local lab = variable_label[`i']
    local p1  = t1_fmt[`i']
    local p2  = t2_fmt[`i']
    local p3  = t3_fmt[`i']

    file write tex ///
        "`lab' & `p1' & `p2' & `p3' \\" _n
}

file write tex "\hline" _n
file write tex "\end{tabular}" _n

file write tex "\vspace{0.4em}" _n

file write tex "\begin{minipage}{0.98\textwidth}" _n

file write tex ///
    "\footnotesize Notes: Entries report the unweighted proportion of observations, expressed as a percentage, whose fitted value from the linear probability model is strictly below 0 or above 1. Each LPM uses the same estimation sample, regressors, survey weights, year fixed effects, and municipality fixed effects as the corresponding Logit model. In Panels A and B, controls include age and a male indicator. In Panel C, controls include age, male, and Post interacted with the remaining municipal characteristics. Panel D uses tercile-specific samples and includes controls for age and a male indicator." _n

file write tex "\end{minipage}" _n
file write tex "\end{table}" _n

file close tex

* ---------------------------------------------------------------------------- *
* 15. Mensaje final
* ---------------------------------------------------------------------------- *

display as result _newline ///
    "Proceso terminado. Tablas Logit principales:"

display as result "  `excel_file'"
display as result ///
    "  $output_tex/logit_post_share_mfx_glm_cluster_se_stata.tex"
display as result ///
    "  $output_tex/logit_post_x_mfx_glm_cluster_se_stata.tex"
display as result ///
    "  $output_tex/logit_triple_mfx_glm_cluster_se_stata.tex"
display as result ///
    "  $output/heterog_terciles_migration_lapop_stata.xlsx"
display as result ///
    "  $output/migration_subsamples_lapop_stata.tex"

display as result _newline ///
    "Tablas LPM separadas para el anexo:"

display as result "  `lpm_excel'"
display as result _newline ///
    "Tabla LPM unificada para el anexo:"

display as result ///
    "  $output_tex/lpm_outside_01_all_stata.tex"
